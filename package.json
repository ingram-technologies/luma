{
	"name": "@ingram-tech/luma",
	"version": "0.3.0",
	"description": "TypeScript client for the Luma (lu.ma) public API.",
	"license": "MIT",
	"author": "Ingram Technologies",
	"keywords": [
		"luma",
		"lu.ma",
		"events",
		"api",
		"client",
		"sdk"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/luma.git"
	},
	"bugs": "https://github.com/ingram-technologies/luma/issues",
	"homepage": "https://github.com/ingram-technologies/luma#readme",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "bun run build",
		"generate": "curl -sSf https://public-api.luma.com/openapi.json -o openapi.json && openapi-typescript openapi.json -o src/generated/openapi.ts && biome format --write src/generated/openapi.ts",
		"lint": "biome check .",
		"format": "biome format --write .",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest --run",
		"ci": "bun run type-check && bun run lint && bun run test:run && bun run build"
	},
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^26.1.2",
		"openapi-typescript": "^7.13.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
